# Supabase Configuration
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional but recommended: PostHog Analytics
# VITE_POSTHOG_KEY=your_posthog_key
# VITE_POSTHOG_HOST=https://app.posthog.com

# Optional: Sentry Error Monitoring
# VITE_SENTRY_DSN=your_sentry_dsn
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SENTRY_ORG=your_sentry_org_slug
# SENTRY_PROJECT=your_sentry_project_slug

# Domain split configuration
# The public-facing share domain. Sharing links always point here,
# even when the app is hosted at app.deckly.space.
VITE_SHARE_BASE_URL=https://deckly.space
# Cloudflare Turnstile is a CAPTCHA alternative. This variable is optional — if unset, signup/login forms will not show a CAPTCHA widget.
VITE_TURNSTILE_SITE_KEY=your_turnstile_key

# Help & Feedback form
# Optional: Create a Tally form for support and paste its share or embed URL here.
VITE_TALLY_FEEDBACK_URL=https://tally.so/r/your-form-id

# Supabase bootstrap helper variables used by `npm run supabase:bootstrap`
# SUPABASE_PROJECT_REF=your_supabase_project_ref
# SUPABASE_DB_PASSWORD=your_supabase_database_password
# SUPABASE_ADMIN_EMAIL=you@yourcompany.com


# Optional: local browser fallback used outside Vite/browser contexts
# BASE_URL=http://localhost:5173

# Supabase Edge Functions / deployment secrets
# These are used by Supabase functions and local Supabase CLI, not the browser app.
# Reuse the same project URL as VITE_SUPABASE_URL and the same anon key as VITE_SUPABASE_PUBLISHABLE_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# PROJECT_SECRET_KEY=your_supabase_project_secret_key
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_HTTP_REFERER=http://localhost:5173
# OPENROUTER_APP_TITLE=Deckly
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# R2_S3_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_DECKS_BUCKET=decks
# R2_ASSETS_BUCKET=assets
# R2_PUBLIC_ASSET_BASE_URL=https://assets.yourdomain.com
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_PRIVATE_GATEWAY_BASE_URL=https://storage-gateway.yourdomain.com
# VITE_R2_PUBLIC_ASSET_BASE_URL=https://assets.yourdomain.com
# VITE_R2_PRIVATE_GATEWAY_BASE_URL=https://storage-gateway.yourdomain.com
# CONVERT_API_SECRET=your_convert_api_secret
# CRON_SECRET=your_cron_secret
# SITE_URL=http://127.0.0.1:3000
